# ---------------------------------------------------------------
# Imboni (DataMinds) — environment configuration template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------

# Primary database (MySQL 8 via PyMySQL). The database name contains a hyphen;
# the app quotes it safely (`nisr-hachathon`) when creating it.
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=mysql+pymysql://<db_user>:<db_password>@localhost:3306/nisr-hachathon

# If the primary database is unreachable, fall back to a local SQLite file so the
# app stays usable. Set to false in production to fail loudly instead.
DB_FALLBACK_ENABLED=true
DB_FALLBACK_URL=sqlite:///./data/imboni.db

# Create the MySQL database (CREATE DATABASE IF NOT EXISTS) at startup when the
# configured user has permission. Never creates users or changes passwords.
DB_CREATE_DATABASE=true

# Comma-separated list of allowed browser origins for the API (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# development | production   (API docs at /api/docs are only enabled in development)
APP_ENV=development
LOG_LEVEL=INFO

# Frontend (Vite) — base URL of the API. Leave empty when the backend serves the
# built frontend from the same origin.
VITE_API_BASE_URL=
